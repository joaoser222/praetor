# syntax=docker/dockerfile:1
#
# Imagem de PRODUÇÃO do frontend.
#
# Estágio 1: compila o bundle com Vite (o VITE_API_URL é embutido no build).
# Estágio 2: serve os arquivos estáticos com nginx (SPA) e faz proxy de /api.
#
# O contexto de build é a pasta ./web:
#   docker build -f Dockerfile.web.prod -t praetor-web:prod --build-arg VITE_API_URL=/api web

# ------------------------------------------------------------------ build ----
FROM node:22-slim AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Variável consumida pelo Vite em tempo de BUILD (fica embutida no bundle).
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ---------------------------------------------------------------- runtime ----
FROM nginx:1.27-alpine AS runtime

# Configuração do SPA + proxy /api -> serviço "api".
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Somente o resultado do build (sem node_modules, sem código-fonte).
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
