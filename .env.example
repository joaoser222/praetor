# =============================================================================
# Configuração central — um único .env para todos os ambientes
# =============================================================================
#
#   cp .env.example .env
#
# O mesmo arquivo é lido por:
#   - a aplicação rodando fora do Docker (config/settings.py -> env_file=".env");
#   - o Docker Compose, em ambos os ambientes:
#       develop:    docker-compose.yml
#       production: docker-compose.prod.yml
#
# Cada compose sobrescreve apenas o que difere entre ambientes (DEBUG,
# DATABASE_URL). Por isso não há .env separado por ambiente.
# =============================================================================

# --- Identidade --------------------------------------------------------------
# Nome técnico do projeto (slug em minúsculas): vira o nome do projeto Compose,
# das imagens (<PROJECT_NAME>-api / -web) e dos containers/rede. Troque aqui
# para reaproveitar o boilerplate noutro projeto.
PROJECT_NAME=praetor

# --- Aplicação ---------------------------------------------------------------
APP_NAME="Praetor"
DEBUG=True
# APP_VERSION deriva do `version` do pyproject.toml (fonte única). Defina aqui
# apenas para sobrescrever:
# APP_VERSION="0.1.0"

# --- Servidor (usado ao rodar o uvicorn localmente) --------------------------
SERVER_HOST="127.0.0.1"
SERVER_PORT=8000

# --- Banco de dados ----------------------------------------------------------
# Padrão de desenvolvimento: SQLite (é o que `docker compose up` usa).
# Em produção o compose define DATABASE_URL para PostgreSQL automaticamente.
#
# Exemplos:
#   SQLite:     sqlite+aiosqlite:///./default.db
#   PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL="sqlite+aiosqlite:///./default.db"

# Credenciais do PostgreSQL (consumidas pelo docker-compose.prod.yml).
POSTGRES_USER=praetor
POSTGRES_PASSWORD="troque-esta-senha"
POSTGRES_DB=praetor

# --- Segurança ---------------------------------------------------------------
# Troque por uma chave longa e aleatória: `openssl rand -hex 32`
SECRET_KEY="troque-por-uma-chave-longa-e-aleatoria"
ALGORITHM="HS256"
# Janela máxima de validade de um access token já emitido (JWT não é revogável).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Cookies de auth: por padrão ficam "Secure" fora de DEBUG (exigem HTTPS).
# Descomente para forçar o contrário (ex.: servindo por HTTP fora de localhost):
# COOKIE_SECURE=false

# --- Celery ------------------------------------------------------------------
# Exemplo Redis (padrão): CELERY_BROKER_URL="redis://localhost:6379/0"
# Exemplo RabbitMQ:       CELERY_BROKER_URL="amqp://user:password@host:5672/"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# --- CORS --------------------------------------------------------------------
# Origens compartilhadas pelos ambientes (5173 = Vite em dev; 8080 = nginx em prod).
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]'
