# =============================================================================
# Configuração central — um único .env para todos os ambientes
# =============================================================================
#
#   cp .env.example .env
#
# O mesmo arquivo é lido por:
#   - a aplicação rodando fora do Docker (config/settings.py -> env_file=".env");
#   - o Docker Compose, em ambos os ambientes:
#       dev:        docker-compose.yml
#       prod:       docker-compose.prod.yml
#
# Cada compose sobrescreve apenas o que difere entre ambientes (DEBUG,
# DATABASE_URL). Por isso não há .env separado por ambiente.
# =============================================================================

# --- Identidade --------------------------------------------------------------
# Nome técnico do projeto (slug em minúsculas): vira o nome do projeto Compose,
# das imagens (<PROJECT_NAME>-api / -caddy) e dos containers/rede. Troque aqui
# para reaproveitar o boilerplate noutro projeto.
PROJECT_NAME=praetor

# --- URLs (gerenciadas pelo Caddy) -------------------------------------------
# O Caddy (docker/caddy/) é quem expõe frontend e API, num único host:
#   produção: HTTPS automático (Let's Encrypt) no APP_DOMAIN — obrigatório lá.
#             Exige um domínio real apontando para o host e 80/443 públicos.
#   dev:      host local com certificado da CA interna do Caddy (tls internal).
#             Prefira `*.localhost`, que o próprio navegador resolve para 127.0.0.1.
APP_DOMAIN=
DEV_DOMAIN=


# --- Aplicação ---------------------------------------------------------------
APP_NAME="Praetor"
DEBUG=True
# APP_VERSION deriva do `version` do pyproject.toml (fonte única). Defina aqui
# apenas para sobrescrever:
# APP_VERSION="0.1.0"

# --- Servidor (usado ao rodar o uvicorn localmente) --------------------------
SERVER_HOST="127.0.0.1"
SERVER_PORT=8000

# --- Docker (desenvolvimento) -----------------------------------------------
# Interface do host onde as portas de dev são publicadas (api 8000, web 5173,
# redis 6379, caddy 8080/8443). Use "0.0.0.0" para acessar de outro dispositivo.
DEV_BIND_HOST=127.0.0.1

# --- Banco de dados ----------------------------------------------------------
# Padrão de desenvolvimento: SQLite (é o que `docker compose up` usa).
# Em produção o compose define DATABASE_URL para PostgreSQL automaticamente.
#
# Exemplos:
#   SQLite:     sqlite+aiosqlite:///./default.db
#   PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL="sqlite+aiosqlite:///./default.db"

# Credenciais do PostgreSQL (consumidas pelo docker-compose.prod.yml).
POSTGRES_USER=praetor
POSTGRES_PASSWORD="troque-esta-senha"
POSTGRES_DB=praetor

# --- Segurança ---------------------------------------------------------------
# Troque por uma chave longa e aleatória: `openssl rand -hex 32`
SECRET_KEY="troque-por-uma-chave-longa-e-aleatoria"
ALGORITHM="HS256"
# Janela máxima de validade de um access token já emitido (JWT não é revogável).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Cookies de auth: por padrão ficam "Secure" fora de DEBUG (exigem HTTPS).
# Descomente para forçar o contrário (ex.: servindo por HTTP fora de localhost):
# COOKIE_SECURE=false

# --- Celery ------------------------------------------------------------------
# Exemplo Redis (padrão): CELERY_BROKER_URL="redis://localhost:6379/0"
# Exemplo RabbitMQ:       CELERY_BROKER_URL="amqp://user:password@host:5672/"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# --- CORS --------------------------------------------------------------------
# SPA e API ficam na MESMA origem (o Caddy serve ambos no mesmo host), então CORS
# só é necessário para o acesso direto em desenvolvimento (Vite em 5173, sem
# passar pelo Caddy). Em produção, troque pela origem real (https://<APP_DOMAIN>)
# apenas se for expor a API a outro host.
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
