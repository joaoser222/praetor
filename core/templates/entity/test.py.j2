import pytest
from fastapi import status


@pytest.mark.asyncio
async def test_get_all_{{ name }}(client):
    """
    Testa o endpoint de listagem de {{ class_name }}.

    Sem autenticação (ou sem permissão), a resposta deve ser 401/403.
    """
    response = await client.get("/api/{{ app_name }}/{{ name }}/")
    assert response.status_code in [
        status.HTTP_200_OK,
        status.HTTP_401_UNAUTHORIZED,
        status.HTTP_403_FORBIDDEN,
    ]


@pytest.mark.asyncio
async def test_create_{{ name }}_unauthorized(client):
    """
    Verifica que criar um {{ name }} exige autenticação/permissão.
    """
    response = await client.post("/api/{{ app_name }}/{{ name }}/", json={})
    assert response.status_code in [
        status.HTTP_401_UNAUTHORIZED,
        status.HTTP_403_FORBIDDEN,
        status.HTTP_422_UNPROCESSABLE_ENTITY,
    ]
