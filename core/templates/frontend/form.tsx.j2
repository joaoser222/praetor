import React from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { {{ name }}Schema, {{ class_name }}FormValues } from '../schema';
import { commonMessages } from '@/lib/i18n';
import { Button, Group, Paper, Stack, TextInput } from '@mantine/core';

interface {{ class_name }}FormProps {
  initialData?: any;
  onSubmit: (data: {{ class_name }}FormValues) => void;
  onCancel: () => void;
  isLoading?: boolean;
}

export const {{ class_name }}Form: React.FC<{{ class_name }}FormProps> = ({ 
  initialData, 
  onSubmit, 
  onCancel, 
  isLoading 
}) => {
  const { register, handleSubmit, formState: { errors } } = useForm<{{ class_name }}FormValues>({
    resolver: zodResolver({{ name }}Schema),
    defaultValues: initialData || {
      name: '',
    },
  });

  return (
    <Paper withBorder radius="md" p="lg">
      <form onSubmit={handleSubmit(onSubmit)}>
        <Stack>
          <TextInput
            label="Nome"
            placeholder="Nome..."
            disabled={isLoading}
            error={errors.name?.message}
            {...register('name')}
          />

          <Group justify="flex-end" mt="sm">
            <Button type="button" variant="default" onClick={onCancel} disabled={isLoading}>
              {commonMessages.cancel}
            </Button>
            <Button type="submit" loading={isLoading}>
              {commonMessages.save}
            </Button>
          </Group>
        </Stack>
      </form>
    </Paper>
  );
};
