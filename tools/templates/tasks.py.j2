#     """
#     Uma task de exemplo que processa alguns dados.
#     """
#     logger.info(f"Processing data with ID: {data_id} in app '{{name}}'")
#     # ... sua lógica demorada aqui ...
#     return f"Data {data_id} processed successfully."
